---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PaginationNav from './PaginationNav.astro';
import RolePromptCard from './RolePromptCard.astro';
import { sourceLinkFromUrl } from '../utils/source';
import { formatCategory, formatTags, sortCategories, tagSearchText } from '../utils/taxonomy';

interface Props {
  rolePrompts: CollectionEntry<'roles'>[];
  allRolePrompts: CollectionEntry<'roles'>[];
  currentPage: number;
  totalPages: number;
  pageSize: number;
}

const { rolePrompts, allRolePrompts, currentPage, totalPages, pageSize } = Astro.props;
const categories = sortCategories(allRolePrompts.map((entry) => entry.data.category));
const pageHref = (page: number) => (page === 1 ? '/roles/' : `/roles/page/${page}/`);
const roleSourceLinks = new Map(
  allRolePrompts.map((rolePrompt) => [
    rolePrompt.id,
    sourceLinkFromUrl(rolePrompt.data.sourceTitle, rolePrompt.data.sourceUrl),
  ]),
);
const visibleRolePrompts = rolePrompts.map((rolePrompt) => ({
  entry: rolePrompt,
  source: roleSourceLinks.get(rolePrompt.id) ?? sourceLinkFromUrl(rolePrompt.data.sourceTitle, rolePrompt.data.sourceUrl),
}));
const searchIndex = allRolePrompts.map((rolePrompt, index) => ({
  id: rolePrompt.id,
  title: rolePrompt.data.title,
  description: rolePrompt.data.description,
  category: formatCategory(rolePrompt.data.category),
  source: roleSourceLinks.get(rolePrompt.id),
  tags: formatTags(rolePrompt.data.tags),
  requiredSkills: formatTags(rolePrompt.data.requiredSkills),
  promptBody: rolePrompt.data.promptBody,
  visibleTags: formatTags(
    rolePrompt.data.requiredSkills.length > 0
      ? rolePrompt.data.requiredSkills
      : [rolePrompt.data.category, ...rolePrompt.data.tags],
  ).slice(0, 5),
  searchText: [
    rolePrompt.data.title,
    rolePrompt.data.description,
    rolePrompt.data.category,
    formatCategory(rolePrompt.data.category),
    roleSourceLinks.get(rolePrompt.id)?.label,
    tagSearchText(rolePrompt.data.tags),
    tagSearchText(rolePrompt.data.requiredSkills),
  ].join(' ').toLowerCase(),
  href: `${pageHref(Math.floor(index / pageSize) + 1)}#${rolePrompt.id}`,
}));
---

<BaseLayout title="角色提示詞" description="整理不同來源的角色型 prompt，快速找到產品、設計、工程、資料與內容工作需要的角色提示詞。" width="wide">
  <section class="hero">
    <h1>角色提示詞</h1>
    <p>收錄 {allRolePrompts.length.toLocaleString('zh-TW')} 個角色型 prompt。每筆都整理成正體中文能力摘要，並附上可點擊的來源標籤，方便回到原始倉庫追溯脈絡。</p>
  </section>

  <section class="filter-bar" aria-label="角色提示詞搜尋與篩選">
    <input id="search" type="search" placeholder="搜尋角色、任務或標籤" aria-label="搜尋角色提示詞" />
    <select id="category" aria-label="依角色類型篩選">
      <option value="">所有角色</option>
      {categories.map((category) => <option value={category}>{category}</option>)}
    </select>
  </section>

  <p class="filter-empty" id="empty">沒有符合條件的角色提示詞。</p>

  <div id="paged-content">
    <PaginationNav
      basePath="/roles/"
      currentPage={currentPage}
      totalPages={totalPages}
      pageSize={pageSize}
      totalItems={allRolePrompts.length}
      label="角色提示詞分頁"
    />

    <section class="grid grid--two" id="items">
      {visibleRolePrompts.map(({ entry: rolePrompt, source }) => (
        <RolePromptCard
          id={rolePrompt.id}
          title={rolePrompt.data.title}
          description={rolePrompt.data.description}
          category={rolePrompt.data.category}
          tags={rolePrompt.data.tags}
          requiredSkills={rolePrompt.data.requiredSkills}
          promptBody={rolePrompt.data.promptBody}
          sourceLabel={source?.label ?? '來源'}
          sourceHref={source?.href ?? rolePrompt.data.sourceUrl}
        />
      ))}
    </section>

  </div>

  <section class="grid grid--two" id="search-results" hidden></section>

  <nav class="pagination" id="search-pagination" aria-label="搜尋結果分頁" hidden>
    <p id="search-summary"></p>
    <div class="pagination__controls">
      <button class="button button--secondary" type="button" data-search-prev>上一頁</button>
      <span id="search-indicator">第 1 頁</span>
      <button class="button button--secondary" type="button" data-search-next>下一頁</button>
    </div>
  </nav>

  <script is:inline define:vars={{ searchIndex, pageSize }}>
    const search = document.querySelector('#search');
    const category = document.querySelector('#category');
    const empty = document.querySelector('#empty');
    const pagedContent = document.querySelector('#paged-content');
    const results = document.querySelector('#search-results');
    const searchPagination = document.querySelector('#search-pagination');
    const searchSummary = document.querySelector('#search-summary');
    const searchIndicator = document.querySelector('#search-indicator');
    const prevSearch = document.querySelector('[data-search-prev]');
    const nextSearch = document.querySelector('[data-search-next]');
    const params = new URLSearchParams(window.location.search);
    let searchPage = 1;

    if (params.get('q')) search.value = params.get('q');

    function createResultCard(entry) {
      const article = document.createElement('article');
      article.className = 'content-card role-prompt-card';
      article.dataset.libraryItem = '';

      const link = document.createElement('a');
      link.className = 'content-card__main';
      link.href = entry.href;

      const kind = document.createElement('span');
      kind.className = 'content-card__kind';
      kind.textContent = '角色提示詞';

      const title = document.createElement('h3');
      title.textContent = entry.title;

      const description = document.createElement('p');
      description.textContent = entry.description;

      link.append(kind, title, description);
      article.append(link);

      const visibleTags = entry.visibleTags;
      const chips = document.createElement('div');
      chips.className = 'chip-row';

      if (entry.source) {
        const source = document.createElement('a');
        source.className = 'source-badge';
        source.href = entry.source.href;
        source.target = '_blank';
        source.rel = 'noopener noreferrer';
        source.textContent = `來源：${entry.source.label}`;
        chips.append(source);
      }

      if (visibleTags.length > 0) {
        visibleTags.forEach((tagText) => {
          const tag = document.createElement('span');
          tag.className = 'tag';
          tag.textContent = tagText;
          chips.append(tag);
        });
      }

      if (chips.children.length > 0) article.append(chips);

      const copyButton = document.createElement('button');
      copyButton.className = 'copy-button';
      copyButton.type = 'button';
      copyButton.dataset.copyRolePrompt = '';
      copyButton.textContent = '複製角色提示詞';

      const details = document.createElement('details');
      details.className = 'role-prompt-card__prompt';

      const summary = document.createElement('summary');
      summary.textContent = '查看提示詞';

      const pre = document.createElement('pre');
      const code = document.createElement('code');
      code.textContent = entry.promptBody;
      pre.append(code);
      details.append(summary, pre);

      article.append(copyButton, details);

      return article;
    }

    function matchingItems() {
      const query = search.value.trim().toLowerCase();
      const categoryValue = category.value;

      return searchIndex.filter((entry) => {
        return (
          (!query || entry.searchText.includes(query)) &&
          (!categoryValue || entry.category === categoryValue)
        );
      });
    }

    function renderSearch() {
      const query = search.value.trim();
      const hasFilter = query.length > 0 || category.value;
      pagedContent.hidden = hasFilter;
      results.hidden = !hasFilter;
      searchPagination.hidden = !hasFilter;
      empty.style.display = 'none';

      if (!hasFilter) {
        results.replaceChildren();
        return;
      }

      const matches = matchingItems();
      const totalPages = Math.max(1, Math.ceil(matches.length / pageSize));
      searchPage = Math.min(searchPage, totalPages);
      const start = (searchPage - 1) * pageSize;
      const visibleItems = matches.slice(start, start + pageSize);
      results.replaceChildren(...visibleItems.map(createResultCard));
      bindRolePromptCards();

      empty.style.display = matches.length === 0 ? 'block' : 'none';
      const firstVisible = matches.length === 0 ? 0 : start + 1;
      const lastVisible = Math.min(start + pageSize, matches.length);
      searchSummary.textContent = matches.length === 0
        ? '沒有符合條件的角色提示詞'
        : `搜尋結果第 ${firstVisible.toLocaleString('zh-TW')}-${lastVisible.toLocaleString('zh-TW')} 筆，共 ${matches.length.toLocaleString('zh-TW')} 筆`;
      searchIndicator.textContent = `第 ${searchPage.toLocaleString('zh-TW')} / ${totalPages.toLocaleString('zh-TW')} 頁`;
      prevSearch.disabled = searchPage <= 1;
      nextSearch.disabled = searchPage >= totalPages;
    }

    function bindRolePromptCards() {
      function keepCardInPlace(card) {
        const top = card.getBoundingClientRect().top;

        window.requestAnimationFrame(() => {
          const delta = card.getBoundingClientRect().top - top;
          if (Math.abs(delta) < 1) return;

          const previousScrollBehavior = document.documentElement.style.scrollBehavior;
          document.documentElement.style.scrollBehavior = 'auto';
          window.scrollBy(0, delta);
          document.documentElement.style.scrollBehavior = previousScrollBehavior;
        });
      }

      document.querySelectorAll('[data-copy-role-prompt]').forEach((button) => {
        if (button.dataset.copyBound === 'true') return;
        button.dataset.copyBound = 'true';
        const originalLabel = button.textContent || '複製角色提示詞';

        button.addEventListener('click', async () => {
          const card = button.closest('[data-library-item]');
          const promptText = card?.querySelector('code')?.textContent || '';

          try {
            await navigator.clipboard.writeText(promptText);
            button.textContent = '已複製';
          } catch {
            button.textContent = '複製失敗，請手動選取';
          }

          window.clearTimeout(button.dataset.resetTimer);
          const timer = window.setTimeout(() => {
            button.textContent = originalLabel;
          }, 1600);
          button.dataset.resetTimer = String(timer);
        });
      });

      document.querySelectorAll('.role-prompt-card__prompt').forEach((details) => {
        if (details.dataset.promptBound === 'true') return;
        details.dataset.promptBound = 'true';

        details.querySelector('summary')?.addEventListener('click', () => {
          const card = details.closest('[data-library-item]');
          if (card) keepCardInPlace(card);
        });

        details.addEventListener('toggle', () => {
          details.closest('[data-library-item]')?.classList.toggle('is-expanded', details.open);
        });
      });
    }

    function openHashPrompt() {
      if (!window.location.hash) return;
      const target = document.querySelector(window.location.hash);
      const details = target?.querySelector('.role-prompt-card__prompt');
      if (details) {
        details.open = true;
        target.classList.add('is-expanded');
      }
    }

    [search, category].forEach((control) => {
      control.addEventListener('input', () => {
        searchPage = 1;
        renderSearch();
      });
      control.addEventListener('change', () => {
        searchPage = 1;
        renderSearch();
      });
    });

    prevSearch.addEventListener('click', () => {
      searchPage -= 1;
      renderSearch();
      results.scrollIntoView({ block: 'start' });
    });

    nextSearch.addEventListener('click', () => {
      searchPage += 1;
      renderSearch();
      results.scrollIntoView({ block: 'start' });
    });

    bindRolePromptCards();
    renderSearch();
    openHashPrompt();
  </script>
</BaseLayout>
