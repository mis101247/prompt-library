---
import { formatCategory, formatTag, tagPathSegment, tagSearchText } from '../utils/taxonomy';

interface Props {
  id: string;
  title: string;
  description: string;
  category: string;
  tags: string[];
  requiredSkills: string[];
  promptBody: string;
  sourceLabel: string;
  sourceHref: string;
  initiallyVisible?: boolean;
}

const {
  id,
  title,
  description,
  category,
  tags,
  requiredSkills,
  promptBody,
  sourceLabel,
  sourceHref,
  initiallyVisible = true,
} = Astro.props;
const visibleTags = [...new Set(requiredSkills.length > 0 ? requiredSkills : [category, ...tags.filter((tag) => tag !== category)])].slice(0, 5);
const formattedVisibleTags = visibleTags.map(formatTag);
const formattedCategory = formatCategory(category);
---

<article
  id={id}
  class="content-card role-prompt-card"
  hidden={!initiallyVisible}
  data-library-item
  data-title={title.toLowerCase()}
  data-description={description.toLowerCase()}
  data-category={formattedCategory}
  data-tags={[tagSearchText(tags), tagSearchText(requiredSkills)].join(' ').toLowerCase()}
>
  <div class="content-card__main">
    <span class="content-card__kind">角色提示詞</span>
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
  <div class="chip-row">
    <a class="source-badge" href={sourceHref} target="_blank" rel="noopener noreferrer">來源：{sourceLabel}</a>
    {formattedVisibleTags.map((tag) => <a class="tag" href={`/tags/${encodeURIComponent(tagPathSegment(tag))}/`}>{tag}</a>)}
  </div>
  <button class="copy-button" type="button" data-copy-role-prompt>複製角色提示詞</button>
  <details class="role-prompt-card__prompt">
    <summary>查看提示詞</summary>
    <pre><code>{promptBody}</code></pre>
  </details>
</article>
