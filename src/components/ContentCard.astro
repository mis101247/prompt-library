---
import { formatCategory, formatTag, tagSearchText } from '../utils/taxonomy';

interface Props {
  href: string;
  kind: string;
  title: string;
  description: string;
  category?: string;
  tags?: string[];
  sourceRepo?: string;
  sourceHref?: string;
  sourcePath?: string;
}

const {
  href,
  kind,
  title,
  description,
  category,
  tags = [],
  sourceRepo,
  sourceHref,
  sourcePath,
} = Astro.props;
const formattedCategory = category ? formatCategory(category) : '';
const formattedTags = [...new Set(tags.slice(0, 4).map(formatTag))];
---

<article
  class="content-card"
  data-library-item
  data-title={title.toLowerCase()}
  data-description={description.toLowerCase()}
  data-category={formattedCategory}
  data-tags={tagSearchText(tags ?? []).toLowerCase()}
>
  <a class="content-card__main" href={href}>
    <span class="content-card__kind">{kind}</span>
    <h3>{title}</h3>
    <p>{description}</p>
  </a>
  {(sourceRepo || tags.length > 0) && (
    <div class="chip-row">
      {sourceRepo && sourceHref && (
        <a class="source-badge" href={sourceHref} title={sourcePath ?? sourceRepo} target="_blank" rel="noopener noreferrer">
          來源：{sourceRepo}
        </a>
      )}
      {formattedTags.map((tag) => <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>)}
    </div>
  )}
</article>
