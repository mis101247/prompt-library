---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import ShareMenu from '../../components/ShareMenu.astro';

export async function getStaticPaths() {
  const sources = await getCollection('sources');
  return sources.map((source) => ({
    params: { repo: source.id },
    props: source,
  }));
}

type Props = CollectionEntry<'sources'>;
const source = Astro.props;
const { Content } = await render(source);
const prompts = (await getCollection('prompts')).filter(
  (prompt) => prompt.data.sourceRepo === source.data.repo,
);
const guides = (await getCollection('guides')).filter(
  (guide) => guide.data.sourceRepo === source.data.repo,
);
---

<BaseLayout title={source.data.name} description={source.data.description} width="wide">
  <article class="stack">
    <header class="hero">
      <div class="meta-row">
        <span class="source-badge">{source.data.repo}</span>
        <span class="meta-pill">{source.data.license}</span>
        <span class="meta-pill">{source.data.commit}</span>
      </div>
      <h1>{source.data.name}</h1>
      <p>{source.data.description}</p>
      <div class="hero-actions">
        <a class="button" href={source.data.githubUrl}>GitHub repo</a>
        <a class="button button--secondary" href="/sources/">全部來源</a>
      </div>
    </header>

    <section class="grid grid--two">
      <div class="panel stack">
        <h2>本地位置</h2>
        <p class="source-path">{source.data.localPath}</p>
      </div>
      <div class="panel stack">
        <h2>全文策略</h2>
        <p class="muted">{source.data.fullTextPolicy}</p>
      </div>
    </section>

    <section class="grid grid--two">
      <div class="panel stack">
        <h2>適合挖掘</h2>
        <ul>
          {source.data.bestFor.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="panel stack">
        <h2>起始檔案</h2>
        <ul>
          {source.data.startingFiles.map((item) => <li><code>{item}</code></li>)}
        </ul>
      </div>
    </section>

    <section class="prose">
      <Content />
    </section>

    <section class="section">
      <div class="section-header">
        <div>
          <h2>已收錄提示詞</h2>
          <p>目前從這個 repo 整理出的提示詞。</p>
        </div>
      </div>
      <div class="grid">
        {prompts.length === 0 && <p class="muted">尚未收錄提示詞。</p>}
        {prompts.map((prompt) => (
          <ContentCard
            href={`/prompts/${prompt.id}/`}
            kind="提示詞"
            title={prompt.data.title}
            description={prompt.data.description}
            category={prompt.data.category}
            sourceRepo={prompt.data.sourceRepo}
            sourceHref={prompt.data.sourceUrl}
            sourcePath={prompt.data.sourcePath}
            thumbnailUrl={prompt.data.thumbnailUrl}
            thumbnailAlt={prompt.data.thumbnailAlt}
            tags={prompt.data.tags}
          />
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <div>
          <h2>已衍生指南</h2>
          <p>從來源內容整理出的指南。</p>
        </div>
      </div>
      <div class="grid">
        {guides.length === 0 && <p class="muted">尚未衍生指南。</p>}
        {guides.map((guide) => (
          <ContentCard
            href={`/guides/${guide.id}/`}
            kind="指南"
            title={guide.data.title}
            description={guide.data.description}
            category={guide.data.category}
            sourceRepo={guide.data.sourceRepo}
            sourcePath={guide.data.sourcePath}
            tags={guide.data.tags}
          />
        ))}
      </div>
    </section>

    <section class="panel stack">
      <h2>建議下一步整理素材</h2>
      <ul>
        {source.data.nextMaterials.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <ShareMenu
      title={source.data.name}
      description={source.data.description}
      contentId={`source-${source.id}`}
      canonicalPath={`/sources/${source.id}/`}
      placement="source_detail_footer"
      trackingName="prompt_library_share"
    />
  </article>
</BaseLayout>
