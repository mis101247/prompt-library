---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { sortFeaturedFirst } from '../../utils/content';

const projects = sortFeaturedFirst(await getCollection('projects'));
const categories = [...new Set(projects.map((entry) => entry.data.category))].sort();
---

<BaseLayout title="專案點子" description="適合 vibe coding 的專案點子，搭配可直接使用的提示詞。" width="wide">
  <section class="hero">
    <h1>專案點子</h1>
    <p>每個點子都整理成可以直接開工的小型產品方向，附上 MVP 範圍、可用提示詞與延伸方向。</p>
  </section>

  <section class="filter-bar" aria-label="專案搜尋與篩選">
    <input id="search" type="search" placeholder="搜尋專案、用途或標籤" aria-label="搜尋專案" />
    <select id="category" aria-label="依分類篩選">
      <option value="">所有分類</option>
      {categories.map((category) => <option value={category}>{category}</option>)}
    </select>
  </section>

  <p class="filter-empty" id="empty">沒有符合條件的專案點子。</p>

  <section class="grid grid--two">
    {projects.map((project) => (
      <ContentCard
        href={`/projects/${project.id}/`}
        kind={project.data.featured ? '精選專案' : '專案'}
        title={project.data.title}
        description={project.data.description}
        category={project.data.category}
        tags={project.data.tags}
      />
    ))}
  </section>

  <script is:inline>
    const search = document.querySelector('#search');
    const category = document.querySelector('#category');
    const empty = document.querySelector('#empty');
    const items = [...document.querySelectorAll('[data-library-item]')];

    function applyFilters() {
      const query = search.value.trim().toLowerCase();
      const categoryValue = category.value;
      let visible = 0;

      items.forEach((item) => {
        const haystack = [
          item.dataset.title,
          item.dataset.description,
          item.dataset.tags,
        ].join(' ');
        const show =
          (!query || haystack.includes(query)) &&
          (!categoryValue || item.dataset.category === categoryValue);
        item.style.display = show ? '' : 'none';
        if (show) visible += 1;
      });

      empty.style.display = visible === 0 ? 'block' : 'none';
    }

    [search, category].forEach((control) => {
      control.addEventListener('input', applyFilters);
      control.addEventListener('change', applyFilters);
    });

    applyFilters();
  </script>
</BaseLayout>
