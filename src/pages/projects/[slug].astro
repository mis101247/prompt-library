---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import TagList from '../../components/TagList.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: project,
  }));
}

type Props = CollectionEntry<'projects'>;
const project = Astro.props;
const { Content } = await render(project);
const prompts = (await getCollection('prompts')).filter((prompt) =>
  project.data.usablePrompts.includes(prompt.id),
);
---

<BaseLayout title={project.data.title} description={project.data.description} width="article">
  <article class="stack">
    <header class="hero">
      <h1>{project.data.title}</h1>
      <p>{project.data.oneLiner}</p>
      <TagList tags={project.data.tags} />
    </header>

    <section class="grid grid--two">
      <div class="panel stack">
        <h2>適合誰</h2>
        <ul>
          {project.data.audience.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="panel stack">
        <h2>建議技術</h2>
        <ul>
          {project.data.suggestedStack.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="panel stack">
      <h2>MVP 範圍</h2>
      <ul>
        {project.data.mvpScope.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="prose">
      <Content />
    </section>

    <section class="section">
      <div class="section-header">
        <div>
          <h2>可用提示詞</h2>
          <p>可以直接搭配這個專案點子的提示詞。</p>
        </div>
      </div>
      <div class="grid">
        {prompts.map((prompt) => (
          <ContentCard
            href={`/prompts/${prompt.id}/`}
            kind="提示詞"
            title={prompt.data.title}
            description={prompt.data.description}
            category={prompt.data.category}
            tags={prompt.data.tags}
          />
        ))}
      </div>
    </section>

    <section class="panel stack">
      <h2>延伸方向</h2>
      <ul>
        {project.data.extensions.map((item) => <li>{item}</li>)}
      </ul>
    </section>

  </article>
</BaseLayout>
