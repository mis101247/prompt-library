---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { sortFeaturedFirst } from '../../utils/content';

const prompts = sortFeaturedFirst(await getCollection('prompts'));
const categories = [...new Set(prompts.map((entry) => entry.data.category))].sort();
---

<BaseLayout title="提示詞收藏" description="可搜尋、可篩選、可複製的軟體工程提示詞。" width="wide">
  <section class="hero">
    <h1>提示詞收藏</h1>
    <p>每個提示詞都附上用途、收錄原因與正體中文使用說明。</p>
  </section>

  <section class="filter-bar" aria-label="提示詞搜尋與篩選">
    <input id="search" type="search" placeholder="搜尋標題、用途或標籤" aria-label="搜尋提示詞" />
    <select id="category" aria-label="依分類篩選">
      <option value="">所有分類</option>
      {categories.map((category) => <option value={category}>{category}</option>)}
    </select>
  </section>

  <p class="filter-empty" id="empty">沒有符合條件的提示詞。</p>

  <section class="grid grid--two" id="items">
    {prompts.map((prompt) => (
      <ContentCard
        href={`/prompts/${prompt.id}/`}
        kind={prompt.data.featured ? '精選提示詞' : '提示詞'}
        title={prompt.data.title}
        description={prompt.data.description}
        category={prompt.data.category}
        tags={prompt.data.tags}
      />
    ))}
  </section>

  <script is:inline>
    const search = document.querySelector('#search');
    const category = document.querySelector('#category');
    const empty = document.querySelector('#empty');
    const items = [...document.querySelectorAll('[data-library-item]')];
    const params = new URLSearchParams(window.location.search);

    if (params.get('q')) search.value = params.get('q');

    function applyFilters() {
      const query = search.value.trim().toLowerCase();
      const categoryValue = category.value;
      let visible = 0;

      items.forEach((item) => {
        const haystack = [
          item.dataset.title,
          item.dataset.description,
          item.dataset.tags,
        ].join(' ');
        const matchesQuery = !query || haystack.includes(query);
        const matchesCategory = !categoryValue || item.dataset.category === categoryValue;
        const show = matchesQuery && matchesCategory;
        item.style.display = show ? '' : 'none';
        if (show) visible += 1;
      });

      empty.style.display = visible === 0 ? 'block' : 'none';
    }

    [search, category].forEach((control) => {
      control.addEventListener('input', applyFilters);
      control.addEventListener('change', applyFilters);
    });

    applyFilters();
  </script>
</BaseLayout>
