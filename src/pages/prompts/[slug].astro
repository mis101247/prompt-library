---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import PromptBlock from '../../components/PromptBlock.astro';
import ShareMenu from '../../components/ShareMenu.astro';
import TagList from '../../components/TagList.astro';

export async function getStaticPaths() {
  const prompts = await getCollection('prompts');
  return prompts.map((prompt) => ({
    params: { slug: prompt.id },
    props: prompt,
  }));
}

type Props = CollectionEntry<'prompts'>;
const prompt = Astro.props;
const { Content } = await render(prompt);
const guides = (await getCollection('guides')).filter((guide) =>
  prompt.data.relatedGuides.includes(guide.id),
);
const shouldShowDemoGeneratorNote = prompt.data.category === '趣味應用' && Boolean(prompt.data.thumbnailUrl);
const shareCoverExtension = getShareCoverExtension(prompt.data.thumbnailUrl);
const shareCoverImage = shareCoverExtension ? `/share-covers/${prompt.id}.${shareCoverExtension}` : undefined;

function getShareCoverExtension(value?: string) {
  if (!value) return undefined;

  try {
    const extension = new URL(value).pathname.split('.').pop()?.toLowerCase();
    if (extension && ['gif', 'jpeg', 'jpg', 'png', 'webp'].includes(extension)) return extension;
  } catch {
    return undefined;
  }

  return undefined;
}
---

<BaseLayout title={prompt.data.title} description={prompt.data.description} width="article">
  <article class="stack">
    <header class="hero">
      <div class="meta-row">
        <a class="source-badge" href={prompt.data.sourceUrl} title={prompt.data.sourcePath} target="_blank" rel="noopener noreferrer">
          來源：{prompt.data.sourceRepo}
        </a>
      </div>
      <h1>{prompt.data.title}</h1>
      <p>{prompt.data.description}</p>
      <TagList tags={prompt.data.tags} />
    </header>

    <section class="panel stack">
      <h2>提示詞用途</h2>
      <p class="muted">{prompt.data.promptUseCase}</p>
    </section>

    <PromptBlock
      body={prompt.data.promptBody}
      copyLabel={prompt.data.copyLabel}
    />

    <section class="panel stack">
      <h2>來源</h2>
      <p class="source-path">{prompt.data.sourcePath}</p>
      <a class="button button--secondary" href={prompt.data.sourceUrl} target="_blank" rel="noopener noreferrer">查看原始來源</a>
    </section>

    <section class="prose" data-demo-generator-note={shouldShowDemoGeneratorNote ? 'Demo 圖由 ChatGPT 5.5 實測生成。' : undefined}>
      <Content />
    </section>

    {shouldShowDemoGeneratorNote && (
      <script is:inline>
        const demoProse = document.querySelector('[data-demo-generator-note]');
        const demoNoteText = demoProse?.getAttribute('data-demo-generator-note');

        if (demoProse && demoNoteText) {
          demoProse.querySelectorAll('img').forEach((image) => {
            if (image.nextElementSibling?.classList.contains('demo-generator-note')) return;

            const note = document.createElement('p');
            note.className = 'demo-generator-note';
            note.textContent = demoNoteText;
            image.insertAdjacentElement('afterend', note);
          });
        }
      </script>
    )}

    {guides.length > 0 && (
      <section class="section">
        <div class="section-header">
          <div>
            <h2>相關內容</h2>
            <p>可以接著閱讀的指南。</p>
          </div>
        </div>
        <div class="grid">
          {guides.map((guide) => (
            <ContentCard
              href={`/guides/${guide.id}/`}
              kind="指南"
              title={guide.data.title}
              description={guide.data.description}
              category={guide.data.category}
              tags={guide.data.tags}
            />
          ))}
        </div>
      </section>
    )}

    <ShareMenu
      title={prompt.data.title}
      description={prompt.data.description}
      contentId={`prompt-${prompt.id}`}
      canonicalPath={`/prompts/${prompt.id}/`}
      coverImage={shareCoverImage}
      placement="prompt_detail_footer"
      trackingName="prompt_library_share"
    />
  </article>
</BaseLayout>
