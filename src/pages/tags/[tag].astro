---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { sortByPublishedAt } from '../../utils/content';

const allEntries = [
  ...(await getCollection('prompts')),
  ...(await getCollection('projects')),
  ...(await getCollection('guides')),
];

export async function getStaticPaths() {
  const entries = [
    ...(await getCollection('prompts')),
    ...(await getCollection('projects')),
    ...(await getCollection('guides')),
  ];
  const tags = [...new Set(entries.flatMap((entry) => entry.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const entries = sortByPublishedAt(
  allEntries.filter((entry) => entry.data.tags.includes(tag)),
);
const collectionLabels = {
  prompts: '提示詞',
  projects: '專案',
  guides: '指南',
};
---

<BaseLayout title={`Tag: ${tag}`} description={`所有標記為 ${tag} 的提示詞、專案點子與指南。`} width="wide">
  <section class="hero">
    <h1>Tag: {tag}</h1>
    <p>跨提示詞、專案點子與指南的內容聚合。</p>
  </section>

  <section class="grid grid--two">
    {entries.map((entry) => (
      <ContentCard
        href={`/${entry.collection}/${entry.id}/`}
        kind={collectionLabels[entry.collection]}
        title={entry.data.title}
        description={entry.data.description}
        category={entry.data.category}
        difficulty={entry.data.difficulty}
        timeEstimate={entry.data.timeEstimate}
        sourceRepo={entry.data.sourceRepo}
        sourcePath={entry.data.sourcePath}
        tools={entry.data.tools}
        tags={entry.data.tags}
      />
    ))}
  </section>
</BaseLayout>
