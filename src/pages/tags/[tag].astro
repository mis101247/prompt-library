---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { sortByPublishedAt } from '../../utils/content';
import { formatTag, tagMatches } from '../../utils/taxonomy';

const allEntries = [
  ...(await getCollection('prompts')),
  ...(await getCollection('guides')),
];

export async function getStaticPaths() {
  const entries = [
    ...(await getCollection('prompts')),
    ...(await getCollection('guides')),
  ];
  const tags = [...new Set(entries.flatMap((entry) => entry.data.tags.map(formatTag)))].sort();

  return tags.map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const entries = sortByPublishedAt(
  allEntries.filter((entry) => tagMatches(tag, entry.data.tags)),
);
const showPromptThumbnails = tag === '趣味應用';
const collectionLabels = {
  prompts: '提示詞',
  guides: '指南',
};
---

<BaseLayout title={`Tag: ${tag}`} description={`所有標記為 ${tag} 的提示詞與指南。`} width="wide">
  <section class="hero">
    <h1>Tag: {tag}</h1>
    <p>跨提示詞與指南的內容聚合。</p>
  </section>

  <section class="grid grid--two">
    {entries.map((entry) => (
      <ContentCard
        href={`/${entry.collection}/${entry.id}/`}
        kind={collectionLabels[entry.collection]}
        title={entry.data.title}
        description={entry.data.description}
        category={entry.data.category}
        difficulty={entry.data.difficulty}
        timeEstimate={entry.data.timeEstimate}
        sourceRepo={entry.collection === 'prompts' ? entry.data.sourceRepo : undefined}
        sourceHref={entry.collection === 'prompts' ? entry.data.sourceUrl : undefined}
        sourcePath={entry.collection === 'prompts' ? entry.data.sourcePath : undefined}
        thumbnailUrl={entry.collection === 'prompts' ? entry.data.thumbnailUrl : undefined}
        thumbnailAlt={entry.collection === 'prompts' ? entry.data.thumbnailAlt : undefined}
        thumbnailContainWhite={entry.collection === 'prompts' ? entry.data.thumbnailContainWhite : undefined}
        showThumbnail={entry.collection === 'prompts' && showPromptThumbnails}
        tools={entry.data.tools}
        tags={entry.data.tags}
      />
    ))}
  </section>
</BaseLayout>
