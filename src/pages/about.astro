---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout title={`投稿 ${SITE_TITLE}`} description="投稿頁已移到 /submit/。">
  <script is:inline>
    window.location.replace('/submit/');
  </script>

  <section class="hero">
    <h1>投稿頁已移動</h1>
    <p>這個入口已改名為投稿，正在前往新的投稿頁。</p>
    <div class="hero-actions">
      <a class="button" href="/submit/">前往投稿</a>
    </div>
  </section>
</BaseLayout>
