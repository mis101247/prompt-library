---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from '../components/ContentCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { sortByPublishedAt, sortFeaturedFirst } from '../utils/content';

const prompts = sortFeaturedFirst(await getCollection('prompts'));
const rolePrompts = sortFeaturedFirst(await getCollection('roles'));
const guides = sortFeaturedFirst(await getCollection('guides'));

const featuredPromptIds = [
  'if-my-world-were-a-room',
  'tiny-planet-city-travel-selfie',
  'photo-doodle-annotation-story',
];
const featuredPrompts = featuredPromptIds
  .map((id) => prompts.find((entry) => entry.id === id))
  .filter((entry) => entry !== undefined);
const featuredRolePrompts = rolePrompts.filter((entry) => entry.data.featured).slice(0, 3);
const featuredGuides = guides.filter((entry) => entry.data.featured).slice(0, 3);
const recentUpdates = sortByPublishedAt([...prompts, ...guides]).slice(0, 6);
const collectionLabels = {
  prompts: '提示詞',
  guides: '指南',
};
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} width="wide">
  <section class="hero">
    <h1>{SITE_TITLE}</h1>
    <p>{SITE_DESCRIPTION}</p>
    <form class="filter-bar home-search" action="/prompts/" role="search">
      <label class="home-search__field">
        <span class="home-search__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <path d="m21 21-4.3-4.3m2.3-5.2a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z" />
          </svg>
        </span>
        <input name="q" type="search" placeholder="搜尋提示詞，例如：Code review..." aria-label="搜尋提示詞" />
      </label>
      <button class="button home-search__button" type="submit">搜尋</button>
    </form>
  </section>

  <section class="section">
    <div class="section-header">
      <div>
        <h2>精選提示詞</h2>
        <p>把社群上的趣味 AI 玩法整理成可直接複製、附 Demo 參考的提示詞。</p>
      </div>
      <a class="quiet-link" href="/prompts/">全部提示詞</a>
    </div>
    <div class="grid grid--three">
      {featuredPrompts.map((prompt) => (
        <ContentCard
          href={`/prompts/${prompt.id}/`}
          kind={prompt.data.category}
          title={prompt.data.title}
          description={prompt.data.description}
          category={prompt.data.category}
          tags={prompt.data.tags}
          sourceRepo={prompt.data.sourceRepo}
          sourceHref={prompt.data.sourceUrl}
          sourcePath={prompt.data.sourcePath}
          thumbnailUrl={prompt.data.thumbnailUrl}
          thumbnailAlt={prompt.data.thumbnailAlt}
          thumbnailContainWhite={prompt.data.thumbnailContainWhite}
          showThumbnail={true}
        />
      ))}
    </div>
    <a class="button button--secondary section-cta" href="/prompts/">查看全部提示詞 <span aria-hidden="true">→</span></a>
  </section>

  <section class="section">
    <div class="section-header">
      <div>
        <h2>角色提示詞</h2>
        <p>先選一個角色，再把任務交給 AI。</p>
      </div>
      <a class="quiet-link" href="/roles/">全部角色</a>
    </div>
    <div class="grid grid--three">
      {featuredRolePrompts.map((rolePrompt) => (
        <ContentCard
          href={`/roles/#${rolePrompt.id}`}
          kind="角色"
          title={rolePrompt.data.title}
          description={rolePrompt.data.description}
          category={rolePrompt.data.category}
          tags={rolePrompt.data.tags}
        />
      ))}
    </div>
    <a class="button button--secondary section-cta" href="/roles/">查看全部角色 <span aria-hidden="true">→</span></a>
  </section>

  <section class="section">
    <div class="section-header">
      <div>
        <h2>分類入口</h2>
        <p>先選工作流程，再找相關提示詞。</p>
      </div>
    </div>
    <div class="grid grid--three">
      <a class="content-card" href="/tags/code%20review/">
        <span class="content-card__kind">分類</span>
        <h3>Code Review</h3>
        <p>PR 審查、安全審查、低噪音 AI reviewer 工作流程。</p>
      </a>
      <a class="content-card" href="/tags/testing/">
        <span class="content-card__kind">分類</span>
        <h3>Testing</h3>
        <p>測試金字塔、CI gate、四週測試策略與重構安全網。</p>
      </a>
      <a class="content-card" href="/tags/vibe%20coding/">
        <span class="content-card__kind">分類</span>
        <h3>Vibe Coding</h3>
        <p>從想法、規格、脈絡到 coding agent 驗證迴圈。</p>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <div>
        <h2>精選指南</h2>
        <p>把 prompt repos 的設計整理成容易學的正體中文工作流程。</p>
      </div>
      <a class="quiet-link" href="/guides/">全部指南</a>
    </div>
    <div class="grid grid--three">
      {featuredGuides.map((guide) => (
        <ContentCard
          href={`/guides/${guide.id}/`}
          kind="指南"
          title={guide.data.title}
          description={guide.data.description}
          category={guide.data.category}
          tags={guide.data.tags}
        />
      ))}
    </div>
    <a class="button button--secondary section-cta" href="/guides/">查看全部指南 <span aria-hidden="true">→</span></a>
  </section>

  <section class="section">
    <div class="section-header">
      <div>
        <h2>最近更新</h2>
        <p>最新加入或修改的內容。</p>
      </div>
    </div>
    <div class="grid grid--three" data-mobile-limit="3">
      {recentUpdates.map((entry) => (
        <ContentCard
          href={`/${entry.collection}/${entry.id}/`}
          kind={collectionLabels[entry.collection]}
          title={entry.data.title}
          description={entry.data.description}
          category={entry.data.category}
          tags={entry.data.tags}
          sourceRepo={entry.collection === 'prompts' ? entry.data.sourceRepo : undefined}
          sourceHref={entry.collection === 'prompts' ? entry.data.sourceUrl : undefined}
          sourcePath={entry.collection === 'prompts' ? entry.data.sourcePath : undefined}
          thumbnailUrl={entry.collection === 'prompts' ? entry.data.thumbnailUrl : undefined}
          thumbnailAlt={entry.collection === 'prompts' ? entry.data.thumbnailAlt : undefined}
        />
      ))}
    </div>
  </section>
</BaseLayout>
