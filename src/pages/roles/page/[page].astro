---
import { getCollection } from 'astro:content';
import RoleListPage from '../../../components/RoleListPage.astro';
import { ROLES_PAGE_SIZE } from '../../../consts';
import { sortFeaturedFirst } from '../../../utils/content';

const pageSize = ROLES_PAGE_SIZE;

export async function getStaticPaths() {
  const allRolePrompts = sortFeaturedFirst(await getCollection('roles'));
  const totalPages = Math.ceil(allRolePrompts.length / ROLES_PAGE_SIZE);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
  }));
}

const allRolePrompts = sortFeaturedFirst(await getCollection('roles'));
const totalPages = Math.ceil(allRolePrompts.length / pageSize);
const currentPage = Number(Astro.params.page);
const start = (currentPage - 1) * pageSize;
const rolePrompts = allRolePrompts.slice(start, start + pageSize);
---

<RoleListPage
  rolePrompts={rolePrompts}
  allRolePrompts={allRolePrompts}
  currentPage={currentPage}
  totalPages={totalPages}
  pageSize={pageSize}
/>
