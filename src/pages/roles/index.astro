---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RolePromptCard from '../../components/RolePromptCard.astro';
import { sortFeaturedFirst } from '../../utils/content';

const rolePrompts = sortFeaturedFirst(await getCollection('roles'));
const categories = [...new Set(rolePrompts.map((entry) => entry.data.category))].sort();
---

<BaseLayout title="角色提示詞" description="整理 prompts.chat 的角色型 prompt，快速找到產品、設計、工程、資料與內容工作需要的角色提示詞。" width="wide">
  <section class="hero">
    <h1>角色提示詞</h1>
    <p>收錄 prompts.chat 的 {rolePrompts.length.toLocaleString('zh-TW')} 個角色型 prompt。先找角色，再複製提示詞，適合快速開啟一段有明確任務邊界的 AI 對話。</p>
  </section>

  <section class="filter-bar" aria-label="角色提示詞搜尋與篩選">
    <input id="search" type="search" placeholder="搜尋角色、任務或標籤" aria-label="搜尋角色提示詞" />
    <select id="category" aria-label="依角色類型篩選">
      <option value="">所有角色</option>
      {categories.map((category) => <option value={category}>{category}</option>)}
    </select>
  </section>

  <p class="filter-empty" id="empty">沒有符合條件的角色提示詞。</p>

  <section class="grid grid--two" id="items">
    {rolePrompts.map((rolePrompt) => (
      <RolePromptCard
        id={rolePrompt.id}
        title={rolePrompt.data.title}
        description={rolePrompt.data.description}
        category={rolePrompt.data.category}
        tags={rolePrompt.data.tags}
        promptBody={rolePrompt.data.promptBody}
      />
    ))}
  </section>

  <script is:inline>
    const search = document.querySelector('#search');
    const category = document.querySelector('#category');
    const empty = document.querySelector('#empty');
    const items = [...document.querySelectorAll('[data-library-item]')];

    function applyFilters() {
      const query = search.value.trim().toLowerCase();
      const categoryValue = category.value;
      let visible = 0;

      items.forEach((item) => {
        const haystack = [
          item.dataset.title,
          item.dataset.description,
          item.dataset.tags,
        ].join(' ');
        const show =
          (!query || haystack.includes(query)) &&
          (!categoryValue || item.dataset.category === categoryValue);
        item.style.display = show ? '' : 'none';
        if (show) visible += 1;
      });

      empty.style.display = visible === 0 ? 'block' : 'none';
    }

    [search, category].forEach((control) => {
      control.addEventListener('input', applyFilters);
      control.addEventListener('change', applyFilters);
    });

    document.querySelectorAll('[data-copy-role-prompt]').forEach((button) => {
      const originalLabel = button.textContent || '複製角色提示詞';

      button.addEventListener('click', async () => {
        const card = button.closest('[data-library-item]');
        const promptText = card?.querySelector('code')?.textContent || '';

        try {
          await navigator.clipboard.writeText(promptText);
          button.textContent = '已複製';
        } catch {
          button.textContent = '複製失敗，請手動選取';
        }

        window.clearTimeout(button.dataset.resetTimer);
        const timer = window.setTimeout(() => {
          button.textContent = originalLabel;
        }, 1600);
        button.dataset.resetTimer = String(timer);
      });
    });

    applyFilters();
  </script>
</BaseLayout>
