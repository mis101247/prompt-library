---
import { getCollection } from 'astro:content';
import RoleListPage from '../../components/RoleListPage.astro';
import { sortFeaturedFirst } from '../../utils/content';

const pageSize = 10;
const allRolePrompts = sortFeaturedFirst(await getCollection('roles'));
const rolePrompts = allRolePrompts.slice(0, pageSize);
const totalPages = Math.ceil(allRolePrompts.length / pageSize);
---

<RoleListPage
  rolePrompts={rolePrompts}
  allRolePrompts={allRolePrompts}
  currentPage={1}
  totalPages={totalPages}
  pageSize={pageSize}
/>
