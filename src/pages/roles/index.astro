---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RolePromptCard from '../../components/RolePromptCard.astro';
import { sortFeaturedFirst } from '../../utils/content';

const rolePrompts = sortFeaturedFirst(await getCollection('roles'));
const categories = [...new Set(rolePrompts.map((entry) => entry.data.category))].sort();
---

<BaseLayout title="角色提示詞" description="整理 prompts.chat 的角色型 prompt，快速找到產品、設計、工程、資料與內容工作需要的角色提示詞。" width="wide">
  <section class="hero">
    <h1>角色提示詞</h1>
    <p>收錄 prompts.chat 的 {rolePrompts.length.toLocaleString('zh-TW')} 個角色型 prompt。每筆都整理成正體中文能力摘要，說明這個角色提示詞需要 AI 動用哪些專業判斷。</p>
  </section>

  <section class="filter-bar" aria-label="角色提示詞搜尋與篩選">
    <input id="search" type="search" placeholder="搜尋角色、任務或標籤" aria-label="搜尋角色提示詞" />
    <select id="category" aria-label="依角色類型篩選">
      <option value="">所有角色</option>
      {categories.map((category) => <option value={category}>{category}</option>)}
    </select>
  </section>

  <p class="filter-empty" id="empty">沒有符合條件的角色提示詞。</p>

  <nav class="pagination" aria-label="角色提示詞分頁" data-pagination>
    <p data-page-summary>顯示第 1-20 筆</p>
    <div class="pagination__controls">
      <button class="button button--secondary" type="button" data-prev-page>上一頁</button>
      <span data-page-indicator>第 1 頁</span>
      <button class="button button--secondary" type="button" data-next-page>下一頁</button>
    </div>
  </nav>

  <section class="grid grid--two" id="items">
    {rolePrompts.map((rolePrompt, index) => (
      <RolePromptCard
        id={rolePrompt.id}
        title={rolePrompt.data.title}
        description={rolePrompt.data.description}
        category={rolePrompt.data.category}
        tags={rolePrompt.data.tags}
        requiredSkills={rolePrompt.data.requiredSkills}
        promptBody={rolePrompt.data.promptBody}
        initiallyVisible={index < 20}
      />
    ))}
  </section>

  <nav class="pagination pagination--bottom" aria-label="角色提示詞分頁" data-pagination>
    <p data-page-summary>顯示第 1-20 筆</p>
    <div class="pagination__controls">
      <button class="button button--secondary" type="button" data-prev-page>上一頁</button>
      <span data-page-indicator>第 1 頁</span>
      <button class="button button--secondary" type="button" data-next-page>下一頁</button>
    </div>
  </nav>

  <script is:inline>
    const search = document.querySelector('#search');
    const category = document.querySelector('#category');
    const empty = document.querySelector('#empty');
    const pageSummaries = [...document.querySelectorAll('[data-page-summary]')];
    const pageIndicators = [...document.querySelectorAll('[data-page-indicator]')];
    const prevPages = [...document.querySelectorAll('[data-prev-page]')];
    const nextPages = [...document.querySelectorAll('[data-next-page]')];
    const items = [...document.querySelectorAll('[data-library-item]')];
    const pageSize = 20;
    let currentPage = 1;

    function matchingItems() {
      const query = search.value.trim().toLowerCase();
      const categoryValue = category.value;

      return items.filter((item) => {
        const haystack = [
          item.dataset.title,
          item.dataset.description,
          item.dataset.tags,
        ].join(' ');
        return (
          (!query || haystack.includes(query)) &&
          (!categoryValue || item.dataset.category === categoryValue)
        );
      });
    }

    function renderPage() {
      const matches = matchingItems();
      const totalPages = Math.max(1, Math.ceil(matches.length / pageSize));
      currentPage = Math.min(currentPage, totalPages);
      const start = (currentPage - 1) * pageSize;
      const visibleItems = new Set(matches.slice(start, start + pageSize));

      items.forEach((item) => {
        item.hidden = !visibleItems.has(item);
      });

      empty.style.display = matches.length === 0 ? 'block' : 'none';
      const firstVisible = matches.length === 0 ? 0 : start + 1;
      const lastVisible = Math.min(start + pageSize, matches.length);
      const summaryText = matches.length === 0
        ? '沒有符合條件的角色提示詞'
        : `顯示第 ${firstVisible.toLocaleString('zh-TW')}-${lastVisible.toLocaleString('zh-TW')} 筆，共 ${matches.length.toLocaleString('zh-TW')} 筆`;
      const indicatorText = `第 ${currentPage.toLocaleString('zh-TW')} / ${totalPages.toLocaleString('zh-TW')} 頁`;

      pageSummaries.forEach((summary) => {
        summary.textContent = summaryText;
      });
      pageIndicators.forEach((indicator) => {
        indicator.textContent = indicatorText;
      });
      prevPages.forEach((button) => {
        button.disabled = currentPage <= 1;
      });
      nextPages.forEach((button) => {
        button.disabled = currentPage >= totalPages;
      });
    }

    [search, category].forEach((control) => {
      control.addEventListener('input', () => {
        currentPage = 1;
        renderPage();
      });
      control.addEventListener('change', () => {
        currentPage = 1;
        renderPage();
      });
    });

    prevPages.forEach((button) => button.addEventListener('click', () => {
      currentPage -= 1;
      renderPage();
      document.querySelector('#items').scrollIntoView({ block: 'start' });
    }));

    nextPages.forEach((button) => button.addEventListener('click', () => {
      currentPage += 1;
      renderPage();
      document.querySelector('#items').scrollIntoView({ block: 'start' });
    }));

    document.querySelectorAll('[data-copy-role-prompt]').forEach((button) => {
      const originalLabel = button.textContent || '複製角色提示詞';

      button.addEventListener('click', async () => {
        const card = button.closest('[data-library-item]');
        const promptText = card?.querySelector('code')?.textContent || '';

        try {
          await navigator.clipboard.writeText(promptText);
          button.textContent = '已複製';
        } catch {
          button.textContent = '複製失敗，請手動選取';
        }

        window.clearTimeout(button.dataset.resetTimer);
        const timer = window.setTimeout(() => {
          button.textContent = originalLabel;
        }, 1600);
        button.dataset.resetTimer = String(timer);
      });
    });

    document.querySelectorAll('.role-prompt-card__prompt').forEach((details) => {
      details.addEventListener('toggle', () => {
        details.closest('[data-library-item]')?.classList.toggle('is-expanded', details.open);
      });
    });

    renderPage();
  </script>
</BaseLayout>
